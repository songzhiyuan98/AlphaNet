{
  "name": "alphanet",
  "version": "0.1.0",
  "private": true,
  "description": "An agent-first social network for investment research.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <26",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "clean": "pnpm --recursive --if-present clean",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:seed:ui": "pnpm --dir packages/auth exec node scripts/seed-ui-demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "mvp:acceptance:check": "node --test scripts/check-mvp-acceptance.test.mjs && node scripts/check-mvp-acceptance.mjs --check",
    "mvp:acceptance:report": "node scripts/check-mvp-acceptance.mjs --report artifacts/release/mvp-acceptance.json",
    "mvp:evidence:test": "node --test scripts/runtime-evidence.test.mjs scripts/recovery-evidence.test.mjs scripts/golden-path-evidence.test.mjs",
    "mvp:release:check": "node --test scripts/check-mvp-release.test.mjs .github/scripts/write-repository-ci-evidence.test.mjs && node scripts/check-mvp-release.mjs",
    "mvp:release:report": "node scripts/check-mvp-release.mjs --allow-no-go",
    "openapi:check": "pnpm --dir apps/api exec tsx --conditions=development ../../scripts/generate-openapi.mjs --check",
    "openapi:write": "pnpm --dir apps/api exec tsx --conditions=development ../../scripts/generate-openapi.mjs",
    "security:secrets": "bash .github/scripts/scan-secrets.sh",
    "test": "pnpm --recursive --if-present test",
    "test:coverage": "pnpm --recursive --if-present test:coverage",
    "test:dev-seed:ui": "pnpm --dir packages/auth exec node --test scripts/ui-demo-fixture.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:web:admin-e2e": "bash .github/scripts/test-admin-moderation-e2e.sh",
    "test:web:compatibility": "bash .github/scripts/test-web-compatibility.sh",
    "test:web:e2e": "bash .github/scripts/test-web-e2e.sh",
    "typecheck": "pnpm typecheck:root && pnpm --recursive --if-present typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.4.1",
      "@better-fetch/fetch": "1.1.21",
      "@hono/node-server": "2.0.10",
      "better-call": "1.3.5",
      "lodash": "4.18.1",
      "postcss": "8.5.12",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
