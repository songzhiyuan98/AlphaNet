{
  "name": "@alphanet/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alphanet/config": "workspace:*",
    "@alphanet/database": "workspace:*",
    "@alphanet/domain": "workspace:*",
    "@alphanet/integrations": "workspace:*",
    "@alphanet/observability": "workspace:*",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
