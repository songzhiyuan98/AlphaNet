{
  "name": "@alphanet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch --conditions=development src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alphanet/auth": "workspace:*",
    "@alphanet/config": "workspace:*",
    "@alphanet/contracts": "workspace:*",
    "@alphanet/database": "workspace:*",
    "@alphanet/domain": "workspace:*",
    "@alphanet/integrations": "workspace:*",
    "@alphanet/observability": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/proxy-addr": "5.1.0",
    "fastify": "5.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
