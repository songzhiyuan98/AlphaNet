# Docker Compose project isolation. Override this for a second worktree.
COMPOSE_PROJECT_NAME=alphanet

# Images are pinned to immutable multi-platform manifest digests.
POSTGRES_IMAGE=pgvector/pgvector:0.8.1-pg17-bookworm@sha256:3e8b3adfd27b5707128f60956f62a793c3c9326ea8cfaf0eab7adccb5d700b21
REDIS_IMAGE=redis:7.4.2-alpine@sha256:02419de7eddf55aa5bcf49efb74e88fa8d931b4d77c07eff8a6b2144472b6952

# Local-only credentials. Do not reuse these outside a developer machine.
POSTGRES_DB=alphanet
POSTGRES_USER=alphanet
POSTGRES_PASSWORD=alphanet_local_only
POSTGRES_PORT=5432
REDIS_PASSWORD=alphanet_local_only
REDIS_PORT=6379

# Host-process connection strings. If a password or port changes, update these too.
DATABASE_URL=postgresql://alphanet:alphanet_local_only@127.0.0.1:5432/alphanet
REDIS_URL=redis://:alphanet_local_only@127.0.0.1:6379/0

# Seed the default community only when a new PostgreSQL volume is initialized.
ALPHANET_LOAD_SEED=true

# Optional containerized application profiles.
WEB_PORT=3000
API_PORT=4000
MCP_PORT=4100
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp

# Immutable outbox subscription identity. Keep both values identical on every
# replica; change the version and choose a deliberate replay watermark when the
# handler set changes.
OUTBOX_CONSUMER_NAME=alphanet-worker:v1
OUTBOX_REPLAY_FROM=2026-07-20T00:00:00.000Z
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
RUN_ONCE=false

# Log local SQL statements slower than this threshold.
POSTGRES_LOG_MIN_DURATION_MS=500
