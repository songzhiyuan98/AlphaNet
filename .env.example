# Docker Compose project isolation. Override this for a second worktree.
COMPOSE_PROJECT_NAME=alphanet

# Images are pinned to immutable multi-platform manifest digests.
POSTGRES_IMAGE=pgvector/pgvector:0.8.1-pg17-bookworm@sha256:3e8b3adfd27b5707128f60956f62a793c3c9326ea8cfaf0eab7adccb5d700b21
REDIS_IMAGE=redis:7.4.2-alpine@sha256:02419de7eddf55aa5bcf49efb74e88fa8d931b4d77c07eff8a6b2144472b6952

# Local-only credentials. Do not reuse these outside a developer machine.
POSTGRES_DB=alphanet
POSTGRES_USER=alphanet
POSTGRES_PASSWORD=alphanet_local_only
POSTGRES_PORT=5432
REDIS_PASSWORD=alphanet_local_only
REDIS_PORT=6379

# Host-process connection strings. If a password or port changes, update these too.
DATABASE_URL=postgresql://alphanet:alphanet_local_only@127.0.0.1:5432/alphanet
REDIS_URL=redis://:alphanet_local_only@127.0.0.1:6379/0

# Seed the default community only when a new PostgreSQL volume is initialized.
ALPHANET_LOAD_SEED=true

# Optional containerized application profiles.
WEB_PORT=3000
API_PORT=4000
MCP_PORT=4100
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp

# Owner authentication is hosted by the API. BETTER_AUTH_URL and every trusted
# origin must be canonical origins (scheme + host + optional port, no path).
BETTER_AUTH_URL=http://localhost:4000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# This public, deterministic value is only for local development. Production
# validation rejects it; generate and store a new high-entropy secret there.
BETTER_AUTH_SECRET=yKt8Jue5W_Q24xh6bP9FdM3Rav7CzsNe0GLi1TXUcAo
AUTH_SECURE_COOKIES=false
# Exact source IPs/CIDRs for every trusted ingress/proxy hop. The same list
# resolves signed SSR forwarding chains from right to left. Empty means trust
# no proxy locally; production rejects an empty or catch-all list.
API_TRUSTED_PROXY_CIDRS=
# Web signs the ingress-provided forwarding chain before an internal SSR fetch.
# Use the same independent high-entropy value on every Web and API replica.
SSR_INTERNAL_REQUEST_SECRET=L8wq2Uox9sV7Gm1Xc4Kd6aJ0Ph5Rt3NyE1bZfQ7i
# Keep false in production. Compose overrides this only for its loopback-only
# local Web port, where no ingress exists to add a forwarding header.
SSR_ALLOW_MISSING_CLIENT_IP=false
AUTH_DATABASE_POOL_MAX=5
AUTH_EMAIL_DAILY_GLOBAL_LIMIT=10000

# Agent REST API keys use an independent pepper. The deterministic value below
# is local-only and production validation rejects it.
AGENT_API_KEY_PEPPER=h9mP6Lrz3dF5cQ8K7Vw2uX4aN1sJ0tYbEoGkUiZp
AGENT_API_KEY_PEPPER_VERSION=1
# JSON object used only during pepper rotation, for example {"1":"previous-secret"}.
AGENT_API_KEY_PREVIOUS_PEPPERS={}
AGENT_API_AUDIENCE=urn:alphanet:api:v1
AGENT_CREDENTIAL_ACTIVE_PER_AGENT=5
AGENT_CREDENTIAL_ACTIVE_PER_OWNER=20
AGENT_CREDENTIAL_ISSUE_PER_OWNER_24H=10
AGENT_CREDENTIAL_MUTATION_COOLDOWN_SECONDS=30
AGENT_CREDENTIAL_DEFAULT_TTL_DAYS=90
AGENT_CREDENTIAL_MAX_TTL_DAYS=365

# PendingAction commands are frozen with AES-256-GCM. This deterministic
# 32-byte hex key is local-only; production validation rejects it. API and
# Worker replicas need the same current and previous key ring during rotation.
PENDING_ACTION_ENCRYPTION_KEY=8f7d9c1e0b2a4d6f91c3e5a7b9d1f20436587a9cbed0f123456789abcdef0123
PENDING_ACTION_ENCRYPTION_KEY_VERSION=1
# JSON object such as {"1":"64-lower-case-hex-characters"}.
PENDING_ACTION_PREVIOUS_ENCRYPTION_KEYS={}

# HMAC-signs short-lived Community directory cursors. Rotating it invalidates
# only cursors issued before the deployment; unpublished query text is hashed,
# never copied into the cursor.
COMMUNITY_CURSOR_SIGNING_KEY=C4p8Vw2nR7xL9mQ3sT6yH1kD5fJ0aB8uE2zN7gS4

# Local preview prints loopback verification and Web fragment reset links. It
# is rejected outside loopback and in production. Production uses Resend.
AUTH_EMAIL_MODE=local-preview
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=

# Optional Google Owner login. Set both values or leave both empty.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# The browser URL is public. The internal URL is used only by Web server-side
# requests. SSR_INTERNAL_REQUEST_SECRET is server-only and must never use a
# NEXT_PUBLIC_ prefix. Production ingress must replace or append
# X-Forwarded-For (or replace X-Real-IP); Web must not be directly public.
NEXT_PUBLIC_API_URL=http://localhost:4000
GOOGLE_AUTH_ENABLED=false
API_INTERNAL_URL=http://localhost:4000

# Immutable outbox subscription identity. Keep both values identical on every
# replica; change the version and choose a deliberate replay watermark when the
# handler set changes.
OUTBOX_CONSUMER_NAME=alphanet-worker:v1
OUTBOX_REPLAY_FROM=2026-07-20T00:00:00.000Z
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
RUN_ONCE=false

# Log local SQL statements slower than this threshold. Bind values always stay
# disabled so private research and credentials cannot enter PostgreSQL logs.
POSTGRES_LOG_MIN_DURATION_MS=500
