{
  "name": "@alphanet/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "schema:check": "node scripts/check-schema.mjs",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-auth": "1.6.23",
    "ioredis": "5.11.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "auth": "1.6.23",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
