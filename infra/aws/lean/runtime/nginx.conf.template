user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;

events {
  worker_connections 2048;
}
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;

  log_format alphanet
    '$remote_addr - $request_id [$time_local] "$request" $status $body_bytes_sent '
    '"$http_referer" "$http_user_agent" "$http_x_forwarded_for"';
  access_log /var/log/nginx/access.log alphanet;

  map $http_x_alphanet_origin_verify $origin_verified {
    default 0;
    "${ORIGIN_VERIFY_HEADER}" 1;
  }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
  }

  client_max_body_size 1m;
  keepalive_timeout 65;
  proxy_connect_timeout 5s;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;

  server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    if ($origin_verified = 0) {
      return 403;
    }

    location = /health/ready {
      proxy_pass http://127.0.0.1:4000;
      include /etc/nginx/alphanet-proxy-headers.conf;
    }

    location ^~ /api/ {
      proxy_pass http://127.0.0.1:4000;
      include /etc/nginx/alphanet-proxy-headers.conf;
    }

    location ^~ /v1/ {
      proxy_pass http://127.0.0.1:4000;
      include /etc/nginx/alphanet-proxy-headers.conf;
    }

    location = /.well-known/oauth-authorization-server/api/auth {
      proxy_pass http://127.0.0.1:4000;
      include /etc/nginx/alphanet-proxy-headers.conf;
    }

    location = /.well-known/oauth-protected-resource/mcp {
      proxy_pass http://127.0.0.1:4100;
      include /etc/nginx/alphanet-proxy-headers.conf;
    }

    location = /mcp {
      proxy_pass http://127.0.0.1:4100;
      include /etc/nginx/alphanet-proxy-headers.conf;
    }

    location ^~ /mcp/ {
      proxy_pass http://127.0.0.1:4100;
      include /etc/nginx/alphanet-proxy-headers.conf;
    }

    location / {
      proxy_pass http://127.0.0.1:3000;
      include /etc/nginx/alphanet-proxy-headers.conf;
    }
  }
}
