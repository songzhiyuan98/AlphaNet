APP_VERSION=0000000000000000000000000000000000000000
AWS_REGION=us-west-2
NODE_ENV=production
TZ=UTC
LOG_LEVEL=info
RUNTIME_ENV_FILE=runtime.env.example

API_IMAGE=123456789012.dkr.ecr.us-west-2.amazonaws.com/alphanet/api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WEB_IMAGE=123456789012.dkr.ecr.us-west-2.amazonaws.com/alphanet/web@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
MCP_IMAGE=123456789012.dkr.ecr.us-west-2.amazonaws.com/alphanet/mcp@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
WORKER_IMAGE=123456789012.dkr.ecr.us-west-2.amazonaws.com/alphanet/worker@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
MIGRATE_IMAGE=123456789012.dkr.ecr.us-west-2.amazonaws.com/alphanet/migrate@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
REDIS_IMAGE=redis:7.4.2-alpine

DATABASE_URL=postgresql://alphanet_runtime:replace@database.example:5432/alphanet?sslmode=verify-full
REDIS_URL=redis://:replace@redis:6379/0
REDIS_PASSWORD=replace
PGHOST=database.example
PGPORT=5432
PGDATABASE=alphanet
PGUSER=alphanet_migration
PGPASSWORD=replace
PGSSLMODE=verify-full
PGSSLROOTCERT=/opt/alphanet/certs/aws-rds-us-west-2-bundle.pem
ALPHANET_MIGRATION_ROLE=alphanet_migration
ALPHANET_RUNTIME_ROLE=alphanet_runtime
ALPHANET_MIGRATION_PASSWORD=replace
ALPHANET_RUNTIME_PASSWORD=replace

CORS_ORIGINS=https://example.cloudfront.net
BETTER_AUTH_URL=https://example.cloudfront.net
AUTH_TRUSTED_ORIGINS=https://example.cloudfront.net
AUTH_SECURE_COOKIES=true
API_TRUSTED_PROXY_CIDRS=172.30.0.0/24
SSR_ALLOW_MISSING_CLIENT_IP=false
NEXT_PUBLIC_API_URL=
AUTH_EMAIL_MODE=resend
AUTH_EMAIL_FROM=AlphaNet <no-reply@example.invalid>
AUTH_EMAIL_REPLY_TO=
AUTH_DATABASE_POOL_MAX=10
AUTH_EMAIL_DAILY_GLOBAL_LIMIT=100
GOOGLE_AUTH_ENABLED=false
MCP_RUNTIME_ENABLED=true
MCP_PUBLIC_ENABLED=false
MCP_ALLOWED_HOSTS=example.cloudfront.net
MCP_TRUSTED_PROXY_CIDRS=172.30.0.0/24
MCP_RESOURCE=
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URI=
MCP_OAUTH_OWNER_CONSENT_ENABLED=false
MCP_OAUTH_SERVER_ENABLED=false
ADMIN_WEB_ENABLED=false

BETTER_AUTH_SECRET=replace
SSR_INTERNAL_REQUEST_SECRET=replace
AGENT_API_KEY_PEPPER=replace
PENDING_ACTION_ENCRYPTION_KEY=replace
COMMUNITY_CURSOR_SIGNING_KEY=replace
RESEND_API_KEY=replace
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

AGENT_API_AUDIENCE=urn:alphanet:api:v1
AGENT_API_KEY_PEPPER_VERSION=1
AGENT_API_KEY_PREVIOUS_PEPPERS={}
AGENT_CREDENTIAL_ACTIVE_PER_AGENT=5
AGENT_CREDENTIAL_ACTIVE_PER_OWNER=20
AGENT_CREDENTIAL_ISSUE_PER_OWNER_24H=10
AGENT_CREDENTIAL_MUTATION_COOLDOWN_SECONDS=30
AGENT_CREDENTIAL_DEFAULT_TTL_DAYS=90
AGENT_CREDENTIAL_MAX_TTL_DAYS=365
PENDING_ACTION_ENCRYPTION_KEY_VERSION=1
PENDING_ACTION_PREVIOUS_ENCRYPTION_KEYS={}
SEARCH_EMBEDDING_PROVIDER=disabled
SEARCH_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
SEARCH_EMBEDDING_DIMENSIONS=512
SEARCH_EMBEDDING_TIMEOUT_MS=5000
MCP_INTERNAL_API_ENABLED=true
MCP_INTERNAL_API_PORT=4443
MCP_INTERNAL_API_TIMEOUT_MS=15000
MCP_INTERNAL_API_MAX_RESPONSE_BYTES=4194304
OUTBOX_CONSUMER_NAME=alphanet-worker:v2
OUTBOX_REPLAY_FROM=2026-07-20T00:00:00.000Z
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
SEARCH_INDEX_BATCH_SIZE=10
SEARCH_INDEX_LEASE_SECONDS=60
RUN_ONCE=false

MCP_INTERNAL_API_SERVER_CERT_PEM_BASE64=replace
MCP_INTERNAL_API_SERVER_KEY_PEM_BASE64=replace
MCP_INTERNAL_API_CLIENT_CA_PEM_BASE64=replace
MCP_INTERNAL_API_ALLOWED_CLIENT_CERT_SHA256_FINGERPRINTS=replace
MCP_INTERNAL_API_CLIENT_CERT_PEM_BASE64=replace
MCP_INTERNAL_API_CLIENT_KEY_PEM_BASE64=replace
MCP_INTERNAL_API_SERVER_CA_PEM_BASE64=replace
MCP_ACTOR_ASSERTION_CURRENT_KEY_VERSION=1
MCP_ACTOR_ASSERTION_CURRENT_KEY_BASE64=replace
MCP_ACTOR_ASSERTION_PREVIOUS_KEYS={}
MCP_ACTOR_ASSERTION_REPLAY_DIGEST_KEY_BASE64=replace
MCP_ACCESS_TOKEN_JTI_DIGEST_KEY_BASE64=replace
